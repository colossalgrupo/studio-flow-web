# Copie este arquivo para `.env.local` e ajuste os valores conforme o ambiente.
# Nenhuma variável é obrigatória hoje: o painel funciona 100% com dados mock
# (veja `lib/mock/` e `services/*.ts`). Elas existem para quando a API real
# do `studio-flow-backend` estiver disponível.

# URL base da API backend (Kotlin + Spring Boot), sem barra final,
# ex.: https://api.studioflow.app. Usada no client, por isso precisa do
# prefixo NEXT_PUBLIC_. Enquanto não configurada, os `services/*.ts`
# continuam usando os dados mockados de `lib/mock/`.
#
# Endpoints de autenticação esperados nessa API (ver services/auth.ts):
#   POST /auth/login  { email, senha } -> { token, usuario }
#   GET  /auth/me     (Bearer token)   -> usuario
#   POST /auth/logout (Bearer token)
NEXT_PUBLIC_API_URL=
